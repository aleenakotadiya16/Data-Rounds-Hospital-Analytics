table inpatient_admission_analysis
	lineageTag: cfaa2bc5-a905-4724-8633-791b12eee6ba

	/// Distinct count of inpatient admission episodes.
	measure 'Total Inpatient Admissions' = DISTINCTCOUNT('inpatient_admission_analysis'[admission_id])
		formatString: #,##0
		displayFolder: Admission Metrics
		lineageTag: 7423ef14-420f-41d8-a53c-2eff50864f12

	/// Inpatient admission episodes eligible for 30-day follow-up observation.
	measure 'Eligible Admissions' = CALCULATE([Total Inpatient Admissions], 'inpatient_admission_analysis'[followup_eligible] = TRUE())
		formatString: #,##0
		displayFolder: Readmission Metrics
		lineageTag: bbd272fe-1810-4d70-9682-755667117e3f

	/// Eligible inpatient admission episodes with a derived 30-day return flag of 1.
	measure '30-Day Returns' = CALCULATE([Total Inpatient Admissions], 'inpatient_admission_analysis'[followup_eligible] = TRUE(), 'inpatient_admission_analysis'[return_30d_flag] = 1)
		formatString: #,##0
		displayFolder: Readmission Metrics
		lineageTag: ed8df4af-8f3c-4ddf-8196-380808ec71e1

	/// Eligible inpatient admission episodes with a derived 30-day return divided by eligible admissions.
	measure '30-Day Return Rate' = DIVIDE([30-Day Returns], [Eligible Admissions])
		formatString: 0.00%
		displayFolder: Readmission Metrics
		lineageTag: f660f365-b497-46c3-96f7-ec1f3491b399

	/// Average length of stay in days across inpatient admission episodes.
	measure 'Average LOS (Days)' = AVERAGE('inpatient_admission_analysis'[los_days])
		formatString: #,##0.00
		displayFolder: Admission Metrics
		lineageTag: 6c1c1088-9f2e-48bb-96c3-7f1f8d03b436

	/// Median length of stay in days across inpatient admission episodes.
	measure 'Median LOS (Days)' = MEDIAN('inpatient_admission_analysis'[los_days])
		formatString: #,##0.00
		displayFolder: Admission Metrics
		lineageTag: a9f4194f-55dc-4fbd-96db-c07466ecafbc

