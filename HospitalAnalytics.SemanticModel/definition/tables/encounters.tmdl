table encounters
	lineageTag: acfe1b6e-8917-4b3e-b268-88606331c40b

	/// Distinct count of encounter records at the encounter grain.
	measure 'Total Encounters' = DISTINCTCOUNT('encounters'[Id])
		formatString: #,##0
		displayFolder: Encounter Metrics
		lineageTag: 9f0134ec-de86-4c83-81e5-1ee1da63d9c3

	/// Sum of recorded total claim cost from encounters. Source currency is not specified in the imported model.
	measure 'Total Claim Cost' = SUM('encounters'[TOTAL_CLAIM_COST])
		formatString: #,##0.00
		displayFolder: Financial Metrics
		lineageTag: 98603d85-416a-4116-9b49-e7dab8d0130c

	/// Sum of recorded payer coverage from encounters. Source currency is not specified in the imported model.
	measure 'Total Payer Coverage' = SUM('encounters'[PAYER_COVERAGE])
		formatString: #,##0.00
		displayFolder: Financial Metrics
		lineageTag: aefc5f29-f4dd-4ac0-a0bc-6ed3ad3aa791

	/// Recorded total claim cost less recorded payer coverage.
	measure 'Recorded Cost-Coverage Gap' = [Total Claim Cost] - [Total Payer Coverage]
		formatString: #,##0.00
		displayFolder: Financial Metrics
		lineageTag: 10251a44-5d26-4f5c-adb4-f109c72d6655

	/// Average recorded total claim cost per encounter.
	measure 'Average Claim Cost' = AVERAGE('encounters'[TOTAL_CLAIM_COST])
		formatString: #,##0.00
		displayFolder: Financial Metrics
		lineageTag: f2198257-c718-480e-850e-40b0c50702c6

	/// Recorded payer coverage divided by recorded total claim cost.
	measure 'Payer Coverage Percentage' = DIVIDE([Total Payer Coverage], [Total Claim Cost])
		formatString: 0.00%
		displayFolder: Financial Metrics
		lineageTag: 7fdfd7be-cb0e-4834-803f-2d0d51b7be9b

